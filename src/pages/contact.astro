---
import Layout from '@layouts/Layout.astro'
---

<Layout title='Ivan Farias | Contact'>
  <main class='mx-auto w-full max-w-[880px] px-8'>
    <section class='pt-22'>
      <div class='text-dim prompt-glyph text-sm'>mail -s "hello"</div>
      <h1 class='text-ink mt-3 text-3xl font-bold tracking-tight md:text-5xl'>
        Contact
      </h1>
      <p class='text-dim mt-6 max-w-[58ch]'>
        Have a project, an opportunity, or something interesting to discuss?
        Get in touch by email or connect with me through my social profiles.
      </p>
    </section>

    <section
      class='border-border bg-panel mt-12 flex max-w-[640px] flex-col gap-5 border p-8'
    >
      <div class='text-dim text-[13px]'>
        <span class='text-accent'>$</span> email
      </div>

      <a
        href='mailto:ibmfarias@hotmail.com'
        class='text-accent border-accent-dim w-fit border-b text-[15px] hover:opacity-80'
      >
        ibmfarias@hotmail.com
      </a>

      <div class='text-dim mt-4 text-[13px]'>
        <span class='text-accent'>$</span> connect
      </div>

      <div class='flex flex-wrap gap-x-5 gap-y-2 text-[13px]'>
        <a
          href='https://github.com/ibmfarias'
          target='_blank'
          rel='noreferrer'
          class='text-dim hover:text-accent'
        >
          github
        </a>
        <a
          href='https://x.com/ivanfarias_'
          target='_blank'
          rel='noreferrer'
          class='text-dim hover:text-accent'
        >
          x
        </a>
        <a
          href='https://www.linkedin.com/in/ivanbmf'
          target='_blank'
          rel='noreferrer'
          class='text-dim hover:text-accent'
        >
          linkedin
        </a>
      </div>
    </section>
  </main>
</Layout>